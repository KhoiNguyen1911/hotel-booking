# Copy this file's variable names into your hosting dashboard (Vercel > Settings > Environment Variables).
# Never commit real values.

# Turso database (https://turso.tech) - leave unset to use the local file data/hotel.db
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=

# Long random string used to sign login cookies (required on the server).
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Password for the admin account admin@aurelia.example (created on first start).
ADMIN_PASSWORD=
